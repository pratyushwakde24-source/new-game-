# ==============================================================================
# SPARKVERSE ENVIRONMENT CONFIGURATION
# ==============================================================================

# Port on which the development & production server runs
PORT=3000

# Secret key used for signing session tokens
JWT_SECRET="sparkverse_secure_jwt_secret_replace_in_production"

# Supabase PostgreSQL & Auth Credentials
# Obtain these from your Supabase Dashboard: Project Settings -> API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here"

# CRITICAL SECURITY NOTE:
# The service-role key has administrative privileges (bypassing RLS).
# It MUST NEVER be exposed in frontend bundles or client-side code.
# The SPARKVERSE server handles all score validations and admin mutations.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here"
